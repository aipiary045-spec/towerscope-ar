<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/item_gap"
    android:background="@drawable/bg_wfm_group_card"
    android:orientation="vertical"
    android:padding="0dp">

    <View
        android:id="@+id/rowStatusBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/status_clear" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rowRank"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/source_sans3_semibold"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/rowName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/source_sans3_semibold"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/rowStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_clear"
                android:fontFamily="@font/source_sans3_semibold"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:minHeight="28dp"
                android:paddingHorizontal="8dp"
                android:text="CLEAR"
                android:textColor="@color/status_clear"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/rowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/source_sans3_regular"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rowClearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/source_sans3_semibold"
            android:textColor="@color/accent_yellow"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/rowLinkEstimate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/source_sans3_regular"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <View
            android:id="@+id/rowShimmer"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_shimmer_bar"
            android:visibility="gone" />

        <View
            android:id="@+id/rowShimmer2"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="72dp"
            android:background="@drawable/bg_shimmer_bar"
            android:visibility="gone" />

        <com.towerscope.ar.ui.LosProfileChartView
            android:id="@+id/rowChart"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="10dp"
            android:background="@color/bg_mid"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
