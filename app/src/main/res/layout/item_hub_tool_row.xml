<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nav_tile"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:minHeight="132dp"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_job_icon">

        <ImageView
            android:id="@+id/hubToolIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_wifi_signal" />
    </FrameLayout>

    <TextView
        android:id="@+id/hubToolTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/source_sans3_semibold"
        android:gravity="center"
        android:text="Tool"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hubToolSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/source_sans3_regular"
        android:gravity="center"
        android:maxLines="2"
        android:text="Subtitle"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />
</LinearLayout>
