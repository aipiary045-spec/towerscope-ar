<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/traceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="12dp">

    <include layout="@layout/include_tool_scaffold_header" />

    <ScrollView
        android:id="@+id/traceScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <include layout="@layout/include_wifi_topology" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_wfm_group_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:letterSpacing="0.08"
                    android:text="TARGET"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/traceTargetInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_hud_input"
                    android:fontFamily="@font/source_sans3_regular"
                    android:hint="1.1.1.1 or hostname"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="1.1.1.1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_dim"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/traceToggleButton"
                    style="@style/Widget.TowerScope.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Start traceroute" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:letterSpacing="0.08"
                    android:text="STATUS"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/traceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:text="Ready"
                    android:textColor="@color/accent_teal"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="Hops"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/traceHopView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_wfm_group_card"
                android:fontFamily="@font/source_sans3_regular"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:text="—"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/include_tool_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="18dp" />
</LinearLayout>
