<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/traceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="18dp">

    <include layout="@layout/include_tool_scaffold_header" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/source_sans3_semibold"
        android:letterSpacing="0.1"
        android:text="TARGET"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/traceTargetInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_hud_input"
        android:fontFamily="monospace"
        android:hint="1.1.1.1 or hostname"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:text="1.1.1.1"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_dim"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/traceStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/source_sans3_regular"
        android:text="Ready"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/traceScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <TextView
            android:id="@+id/traceHopView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_input"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/traceToggleButton"
        style="@style/Widget.TowerScope.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:text="Start traceroute" />

    <include
        layout="@layout/include_tool_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="18dp" />
</LinearLayout>
