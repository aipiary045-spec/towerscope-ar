<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wolRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/source_sans3_semibold"
        android:text="@string/home_job_wol"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/screen_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/source_sans3_regular"
        android:text="@string/home_job_wol_sub"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/wolMacInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_hud_input"
        android:fontFamily="monospace"
        android:hint="AA:BB:CC:DD:EE:FF"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/wolBroadcastInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hud_input"
        android:fontFamily="monospace"
        android:hint="255.255.255.255"
        android:inputType="textUri"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/wolStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/source_sans3_semibold"
        android:text="Ready"
        android:textColor="@color/accent_teal"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/wolResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_metric_tile"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:text="Device must be on the same LAN and support WoL."
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/wolSendButton"
        style="@style/Widget.TowerScope.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Send magic packet" />

    <include
        layout="@layout/include_tool_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap"
        android:layout_marginBottom="14dp" />
</LinearLayout>
