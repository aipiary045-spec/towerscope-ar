<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dataMenuRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/source_sans3_semibold"
            android:text="Network sites"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/source_sans3_regular"
            android:text="Import KML, KMZ, or CSV (Ubiquiti / Cambium / GIS). Files are saved on this device."
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sourceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_network_card"
            android:fontFamily="@font/source_sans3_semibold"
            android:padding="14dp"
            android:text="No sites loaded"
            android:textColor="@color/accent_teal"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loadKmlButton"
            style="@style/Widget.TowerScope.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Import KML / KMZ / CSV" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareCsvTemplateButton"
            style="@style/Widget.TowerScope.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Share CSV template" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/source_sans3_regular"
            android:text="Headers: name, latitude, longitude, height_agl (optional). Aliases like site, lat, lng, agl also work."
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearButton"
            style="@style/Widget.TowerScope.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Clear saved data"
            android:textColor="@color/status_blocked"
            app:strokeColor="@color/status_blocked" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneButton"
            style="@style/Widget.TowerScope.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Done" />

        <TextView
            android:id="@+id/menuMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/source_sans3_regular"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
