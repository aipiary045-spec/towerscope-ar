<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wifiRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="12dp">

    <include layout="@layout/include_tool_scaffold_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">
<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_field_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/wifiSsid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/wifiRssi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="42sp" />

                <TextView
                    android:id="@+id/wifiQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_metric_tile"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="—"
                    android:textColor="@color/status_clear"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/wifiMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/source_sans3_regular"
                    android:text="Link  —  ·  Band  —"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/wifiChannelLive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/source_sans3_regular"
                    android:text="Channel  —"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/wifiScanButton"
                style="@style/Widget.TowerScope.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="@string/wifi_scan_nearby" />

            <TextView
                android:id="@+id/wifiScanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/source_sans3_regular"
                android:gravity="center"
                android:text="@string/wifi_scan_hint"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:text="@string/wifi_factors_title"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/wifiInterferenceLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:text="—"
                    android:textColor="@color/status_clear"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/wifiOverlapSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/source_sans3_regular"
                android:text="—"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <include
                android:id="@+id/wifiFactorSpectrum"
                layout="@layout/item_wifi_factor_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                android:id="@+id/wifiFactorRadio"
                layout="@layout/item_wifi_factor_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <include
                android:id="@+id/wifiFactorChannel"
                layout="@layout/item_wifi_factor_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/wifiPlannerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="@string/wifi_channel_planner"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/wifiPlannerResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_metric_tile"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:text="—"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/wifiInterferenceHints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/source_sans3_regular"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="@string/wifi_nearby_aps"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/wifiScanList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/include_tool_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />
</LinearLayout>
