<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_metric_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/portScanRowPort"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/source_sans3_semibold"
        android:text="443 (HTTPS)"
        android:textColor="@color/status_clear"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/portScanRowMs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/source_sans3_regular"
        android:text="12 ms"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />
</LinearLayout>
