<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/source_sans3_regular"
        android:letterSpacing="0.06"
        android:text="@string/location_mode_label"
        android:textColor="@color/text_muted"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/locationModeGpsButton"
            style="@style/Widget.TowerScope.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/location_mode_gps"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/locationModeCustomButton"
            style="@style/Widget.TowerScope.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/location_mode_custom"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/locationModeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/source_sans3_regular"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />
</LinearLayout>
