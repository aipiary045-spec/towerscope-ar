<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen">

    <LinearLayout
        android:id="@+id/aimColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topChrome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp">

                <ImageButton
                    android:id="@+id/compassBackButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/compass_back"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_nav_back"
                    android:tint="@color/text_muted" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/appTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/source_sans3_semibold"
                        android:maxLines="1"
                        android:text="@string/compass_hud_title"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/source_sans3_regular"
                        android:text="@string/compass_hud_sub"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/gpsChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="5dp"
                    android:text="GPS · —"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/compassChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="5dp"
                    android:text="Compass · —"
                    android:textSize="10sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <include
                    android:id="@+id/locationSourceChip"
                    layout="@layout/include_location_source_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/trackingWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_metric_tile"
                android:fontFamily="@font/source_sans3_regular"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="Compass needs calibration"
                android:textColor="@color/chip_poor"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/compassStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field_card"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/headingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:letterSpacing="0.06"
                    android:text="HEADING  —"
                    android:textAllCaps="true"
                    android:textColor="@color/accent_teal"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/focusTowerLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:maxLines="1"
                    android:text="@string/compass_no_tower_in_range"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <LinearLayout
                    android:id="@+id/aimFocusHud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_metric_tile"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/source_sans3_semibold"
                            android:letterSpacing="0.08"
                            android:text="@string/compass_aim_turn_label"
                            android:textAllCaps="true"
                            android:textColor="@color/text_dim"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/aimTurnLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/source_sans3_semibold"
                            android:text="—"
                            android:textColor="@color/accent_yellow"
                            android:textSize="28sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/source_sans3_semibold"
                            android:gravity="end"
                            android:letterSpacing="0.08"
                            android:text="@string/compass_aim_distance_label"
                            android:textAllCaps="true"
                            android:textColor="@color/text_dim"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/aimDistanceLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/source_sans3_semibold"
                            android:gravity="end"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/source_sans3_semibold"
                            android:gravity="end"
                            android:letterSpacing="0.08"
                            android:text="@string/compass_aim_signal_label"
                            android:textAllCaps="true"
                            android:textColor="@color/text_dim"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/aimSignalLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/source_sans3_semibold"
                            android:gravity="end"
                            android:text="Est.  —"
                            android:textColor="@color/accent_teal"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/compassViewport"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_compass_radar_frame"
            android:padding="6dp">

            <com.towerscope.ar.ui.CompassRadarView
                android:id="@+id/compassRadar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/compass_radar_hint" />

            <LinearLayout
                android:id="@+id/compassFabColumn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_nav_floating"
                android:orientation="vertical"
                android:padding="5dp">

                <ImageButton
                    android:id="@+id/calibrateButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_compass_fab"
                    android:contentDescription="@string/compass_improve_title"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_compass_rose"
                    android:tint="@color/accent_yellow" />

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_compass_fab"
                    android:contentDescription="@string/nav_settings"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_settings_cog"
                    android:tint="@color/accent_teal" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottomPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_wfm_group_card"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/visibleCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="Adjust visible range"
                android:focusable="true"
                android:fontFamily="@font/source_sans3_semibold"
                android:gravity="center_vertical"
                android:minHeight="32dp"
                android:text="Visible 0 / 0"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/nearestHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="@string/compass_nearby_label"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:paddingEnd="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/towerChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/compassImproveOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_compass_overlay_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_field_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_compass_rose"
                android:tint="@color/accent_yellow" />

            <TextView
                android:id="@+id/compassImproveTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:gravity="center"
                android:text="@string/compass_improve_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/compassImproveHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/source_sans3_regular"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/compass_improve_hint"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/compassImproveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_cal_state_needed"
                android:fontFamily="@font/source_sans3_semibold"
                android:gravity="center"
                android:minHeight="40dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="STATUS  Waiting…"
                android:textColor="@color/accent_yellow"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/source_sans3_regular"
                android:gravity="center"
                android:text="@string/compass_improve_offset_hint"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compassImproveSunButton"
                style="@style/Widget.TowerScope.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="@string/compass_calibrate_sun" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compassImproveTowerButton"
                style="@style/Widget.TowerScope.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/compass_calibrate_tower" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compassImproveDoneButton"
                style="@style/Widget.TowerScope.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="@string/compass_improve_done" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/permissionGate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_deep"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_compass_rose"
            android:tint="@color/accent_yellow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/source_sans3_semibold"
            android:text="@string/compass_hud_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/source_sans3_regular"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/compass_permission_body"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grantPermissionsButton"
            style="@style/Widget.TowerScope.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="@string/compass_grant_permissions" />
    </LinearLayout>
</FrameLayout>
