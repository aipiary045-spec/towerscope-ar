<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen">

    <com.towerscope.ar.ui.CompassRadarView
        android:id="@+id/compassRadar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="168dp"
        android:layout_marginBottom="118dp"
        android:layout_marginHorizontal="12dp" />

    <LinearLayout
        android:id="@+id/topChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/source_sans3_semibold"
                android:maxLines="1"
                android:text="@string/hud_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gpsChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_hud_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="GPS · —"
                android:textColor="@color/chip_text_on_dark"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/compassChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hud_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Compass · —"
                android:textColor="@color/chip_text_on_dark"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/trackingWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_panel"
            android:paddingHorizontal="12dp"
            android:paddingBottom="6dp"
            android:fontFamily="@font/source_sans3_regular"
            android:text="Compass needs calibration"
            android:textColor="@color/chip_poor"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/compassStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_panel"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/headingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:text="HEADING  —"
                android:textColor="@color/accent_teal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/focusTowerLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/source_sans3_semibold"
                android:maxLines="1"
                android:text="No tower in range"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/aimFocusHud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/aimTurnLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:text="—"
                    android:textColor="@color/accent_yellow"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/aimDistanceLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/source_sans3_semibold"
                        android:gravity="end"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/aimSignalLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="Est.  —"
                        android:textColor="@color/accent_teal"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hud_panel"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/visibleCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/source_sans3_semibold"
            android:text="Visible 0 / 0"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nearestHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/source_sans3_regular"
            android:letterSpacing="0.06"
            android:text="NEARBY"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/towerChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="128dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/calibrateButton"
            android:layout_width="@dimen/fab_size"
            android:layout_height="@dimen/fab_size"
            android:background="@drawable/bg_settings_fab"
            android:contentDescription="Improve compass accuracy"
            android:elevation="8dp"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_compass_rose"
            android:tint="@color/accent_yellow" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="@dimen/fab_size"
            android:layout_height="@dimen/fab_size"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_settings_fab"
            android:contentDescription="Settings"
            android:elevation="8dp"
            android:padding="15dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings_cog"
            android:tint="@color/accent_teal" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/compassImproveOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60B1C2C"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_compass_rose"
                android:tint="@color/accent_yellow" />

            <TextView
                android:id="@+id/compassImproveTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:gravity="center"
                android:text="Improve compass"
                android:textColor="@color/accent_yellow"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/compassImproveHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/source_sans3_regular"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Move the phone in a figure-8 pattern and tilt it. Stay away from metal and magnets."
                android:textColor="#DDFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/compassImproveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_cal_state_needed"
                android:fontFamily="@font/source_sans3_semibold"
                android:gravity="center"
                android:minHeight="40dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="STATUS  Waiting…"
                android:textColor="@color/accent_yellow"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/source_sans3_regular"
                android:gravity="center"
                android:text="@string/compass_improve_offset_hint"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compassImproveSunButton"
                style="@style/Widget.TowerScope.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="@string/compass_calibrate_sun" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compassImproveTowerButton"
                style="@style/Widget.TowerScope.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/compass_calibrate_tower" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC0B1C2C"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="28dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compassImproveDoneButton"
                style="@style/Widget.TowerScope.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Done" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/permissionGate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_deep"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/source_sans3_semibold"
            android:text="@string/hud_title"
            android:textColor="@color/accent_yellow"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/source_sans3_regular"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="High-accuracy location is required to show tower directions on the compass."
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grantPermissionsButton"
            style="@style/Widget.TowerScope.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="Grant permissions" />
    </LinearLayout>
</FrameLayout>
