<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1C2C">

    <FrameLayout
        android:id="@+id/arContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC0B1C2C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="#FFD60A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/themeButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#334155"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Night"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gpsChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="#00E5FF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:text="GPS…"
                android:textColor="#0B1C2C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/earthChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFD60A"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:text="EARTH…"
                android:textColor="#0B1C2C"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/trackingWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC0B1C2C"
            android:paddingHorizontal="12dp"
            android:paddingBottom="6dp"
            android:text="Markers may be inaccurate"
            android:textColor="#FF6B6B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/compassStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC0B1C2C"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/headingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Heading —"
                android:textColor="#00E5FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/focusTowerLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="No tower in range"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/messageBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC0B1C2C"
            android:padding="12dp"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC0B1C2C"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/visibleCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Visible 0 / 0"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/searchField"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="#1AFFFFFF"
            android:hint="Search towers by name"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#99FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/distanceLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Max distance  2.0 km"
            android:textColor="#FFD60A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/distanceSlider"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="9900"
            android:progress="1900" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/dataButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#FFD60A"
                android:text="Data"
                android:textColor="#0B1C2C"
                android:textStyle="bold" />

            <Button
                android:id="@+id/showHiddenButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#FFFFFF"
                android:text="Show hidden"
                android:textColor="#0B1C2C"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/nearestHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nearest matches — tap for details"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/towerChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/permissionGate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B1C2C"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFD60A"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Camera and high-accuracy location are required to place tower markers outdoors."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/grantPermissionsButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#FFD60A"
            android:text="Grant permissions"
            android:textColor="#0B1C2C"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
