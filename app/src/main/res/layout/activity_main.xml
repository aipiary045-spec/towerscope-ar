<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1C2C">

    <FrameLayout
        android:id="@+id/arContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.towerscope.ar.ui.OffScreenTowerOverlay
        android:id="@+id/directionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:id="@+id/topChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/hud_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/hud_title"
                android:textColor="@color/accent_yellow"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings_cog" />

            <TextView
                android:id="@+id/gpsChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_hud_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="GPS · —"
                android:textColor="@color/chip_text_on_dark"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/earthChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hud_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Earth · —"
                android:textColor="@color/chip_text_on_dark"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/trackingWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/hud_panel"
            android:paddingHorizontal="12dp"
            android:paddingBottom="6dp"
            android:text="Tracking weak — markers may drift"
            android:textColor="@color/chip_poor"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/compassStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/hud_panel"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/headingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="HEADING  —"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/focusTowerLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No tower in range"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/hud_panel"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/visibleCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Visible 0 / 0"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nearestHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.06"
            android:text="NEARBY"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/towerChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/calibrationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/calibrationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="88dp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="Center the Sun in the crosshair"
            android:textColor="@color/accent_yellow"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/calibrationHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="116dp"
            android:gravity="center"
            android:paddingHorizontal="28dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="Do not stare at the Sun — glance to align, then confirm"
            android:textColor="#DDFFFFFF"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/calibrationCrosshair"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:contentDescription="Aiming crosshair"
            android:src="@drawable/ic_calibration_crosshair" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC0B1C2C"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="28dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calibrationCancelButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:cornerRadius="6dp"
                app:strokeColor="#66FFFFFF"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calibrationConfirmButton"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="Confirm"
                android:textAllCaps="false"
                android:textColor="#0B1C2C"
                app:backgroundTint="@color/accent_yellow"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/permissionGate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B1C2C"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hud_title"
            android:textColor="@color/accent_yellow"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Camera and high-accuracy location are required to place outdoor tower markers."
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grantPermissionsButton"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="Grant permissions"
            android:textAllCaps="false"
            android:textColor="#0B1C2C"
            app:backgroundTint="@color/accent_yellow"
            app:cornerRadius="6dp" />
    </LinearLayout>
</FrameLayout>
