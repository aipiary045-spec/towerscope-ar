<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hero_compass"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="100dp"
    android:orientation="horizontal"
    android:padding="@dimen/card_padding">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_hero_icon_well">

        <ImageView
            android:id="@+id/heroActionIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_compass_rose"
            android:tint="@color/text_on_accent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/heroActionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/source_sans3_semibold"
            android:text="@string/home_hero_compass_title"
            android:textColor="@color/text_on_accent"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/heroActionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/source_sans3_regular"
            android:text="@string/home_hero_compass_sub"
            android:textColor="@color/text_on_hero_subtle"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/heroActionMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hero_icon_well"
            android:fontFamily="@font/source_sans3_semibold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="@color/text_on_accent"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/source_sans3_semibold"
        android:text="›"
        android:textColor="@color/text_on_hero_dim"
        android:textSize="32sp" />
</LinearLayout>
