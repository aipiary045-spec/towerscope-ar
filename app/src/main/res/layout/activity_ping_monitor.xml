<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/source_sans3_semibold"
        android:text="@string/home_job_ping"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/screen_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/source_sans3_regular"
        android:text="ICMP echo · add :port for TCP (e.g. 192.168.1.1:80)"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/source_sans3_semibold"
        android:letterSpacing="0.1"
        android:text="HOSTS (comma or newline)"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/pingHostInput"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_hud_input"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="1.1.1.1, 8.8.8.8&#10;192.168.1.1:80"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textUri"
        android:minLines="3"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/pingRecentLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/source_sans3_semibold"
        android:letterSpacing="0.1"
        android:text="RECENT"
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/pingRecentScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/pingRecentRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/pingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/source_sans3_regular"
        android:text="Stopped"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/source_sans3_semibold"
        android:letterSpacing="0.1"
        android:text="PER HOST"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/pingHostStatsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:letterSpacing="0.1"
                android:text="LIVE LOG"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/pingLogView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_metric_tile"
                android:fontFamily="monospace"
                android:minHeight="140dp"
                android:padding="12dp"
                android:text="—"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pingToggleButton"
        style="@style/Widget.TowerScope.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Start ping" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pingBackButton"
        style="@style/Widget.TowerScope.Button.Ghost"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/item_gap"
        android:layout_marginBottom="14dp"
        android:text="Back" />
</LinearLayout>
