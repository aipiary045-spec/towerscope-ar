<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="12dp">

    <include layout="@layout/include_tool_scaffold_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <include layout="@layout/include_wifi_topology" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_wfm_group_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:letterSpacing="0.08"
                    android:text="DURATION"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />

                <RadioGroup
                    android:id="@+id/pingDurationGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/pingDurationLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Live" />

                    <RadioButton
                        android:id="@+id/pingDuration1m"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="1 min" />

                    <RadioButton
                        android:id="@+id/pingDuration2m"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="2 min" />

                    <RadioButton
                        android:id="@+id/pingDuration5m"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="5 min" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:letterSpacing="0.08"
                    android:text="HOSTS"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/pingHostInput"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_hud_input"
                    android:fontFamily="@font/source_sans3_regular"
                    android:gravity="top|start"
                    android:hint="1.1.1.1, 8.8.8.8&#10;192.168.1.1:80"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textUri"
                    android:minLines="3"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_dim"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/pingRecentLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:letterSpacing="0.08"
                    android:text="RECENT"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:id="@+id/pingRecentScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/pingRecentRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:letterSpacing="0.08"
                    android:text="STATUS"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/pingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:text="Stopped"
                    android:textColor="@color/accent_teal"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="Per host"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pingHostStatsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="Live log"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/pingLogView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_wfm_group_card"
                android:fontFamily="@font/source_sans3_regular"
                android:minHeight="120dp"
                android:padding="14dp"
                android:text="—"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pingToggleButton"
        style="@style/Widget.TowerScope.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/item_gap"
        android:text="@string/ping_start" />

    <include
        layout="@layout/include_tool_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp" />
</LinearLayout>
