<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/channelPlannerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/stamp_semibold"
        android:letterSpacing="0.08"
        android:text="@string/home_job_channel_plan"
        android:textAllCaps="true"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/screen_title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/source_sans3_regular"
        android:text="@string/home_job_channel_plan_sub"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/channelPlannerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/stamp_semibold"
        android:text="Scanning nearby APs…"
        android:textColor="@color/accent_teal"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/channelPlannerResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_metric_tile"
            android:fontFamily="@font/data_mono"
            android:padding="14dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/channelPlannerScanButton"
        style="@style/Widget.TowerScope.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:text="Scan &amp; recommend" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/channelPlannerBackButton"
            style="@style/Widget.TowerScope.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/channelPlannerShareButton"
            style="@style/Widget.TowerScope.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Share" />
    </LinearLayout>
</LinearLayout>
