<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/installHubRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/source_sans3_semibold"
            android:text="@string/home_hub_install"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/screen_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/source_sans3_regular"
            android:text="Compass, locate, and path clearance for installs"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <include
            android:id="@+id/hubCompassRow"
            layout="@layout/item_hub_tool_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

        <include
            android:id="@+id/hubLocateRow"
            layout="@layout/item_hub_tool_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap" />

        <include
            android:id="@+id/hubLosRow"
            layout="@layout/item_hub_tool_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/installHubImportButton"
            style="@style/Widget.TowerScope.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:text="@string/home_import_sites" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/installHubBackButton"
            style="@style/Widget.TowerScope.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/item_gap"
            android:text="Back" />
    </LinearLayout>
</ScrollView>
