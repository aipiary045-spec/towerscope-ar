<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/installHubRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy">

    <com.towerscope.ar.ui.FaceplateView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingTop="14dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/stamp_semibold"
                    android:letterSpacing="0.22"
                    android:text="BAY AIM"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/stamp_semibold"
                    android:letterSpacing="0.08"
                    android:text="@string/home_hub_install"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/stamp_regular"
                    android:text="Locate, path clearance, and site import"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <include
                    android:id="@+id/hubLocateRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <include
                    android:id="@+id/hubLosRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/installHubImportButton"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/installBottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/include_bottom_nav" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
