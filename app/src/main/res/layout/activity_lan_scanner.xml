<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lanScannerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/source_sans3_semibold"
        android:text="@string/home_job_lan_scan"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/screen_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/source_sans3_regular"
        android:text="@string/home_job_lan_scan_sub"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_metric_card"
        android:orientation="vertical"
        android:padding="@dimen/card_padding_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/source_sans3_semibold"
            android:letterSpacing="0.12"
            android:text="LOCAL SUBNET"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/lanInfoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="—"
            android:textColor="@color/accent_teal"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/source_sans3_regular"
            android:text="Ready to scan"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/source_sans3_semibold"
        android:letterSpacing="0.1"
        android:text="@string/lan_scan_mode_label"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />

    <Spinner
        android:id="@+id/lanModeSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_hud_input"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/source_sans3_semibold"
        android:letterSpacing="0.1"
        android:text="@string/port_scan_host_label"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/lanHostInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_hud_input"
        android:fontFamily="monospace"
        android:hint="@string/port_scan_host_hint"
        android:inputType="textUri"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/lanPortOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/source_sans3_semibold"
            android:letterSpacing="0.1"
            android:text="@string/port_scan_preset_label"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/lanPresetSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_hud_input"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/source_sans3_semibold"
            android:letterSpacing="0.1"
            android:text="EXTRA PORTS (optional)"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/lanExtraPortsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_hud_input"
            android:fontFamily="monospace"
            android:hint="9100, 554 or 8000-8010"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lanResultsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/source_sans3_semibold"
        android:letterSpacing="0.1"
        android:text="OPEN PORTS"
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/lanResultsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/lanScanButton"
        style="@style/Widget.TowerScope.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/lan_scan_start" />

    <include
        layout="@layout/include_tool_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap"
        android:layout_marginBottom="14dp" />
</LinearLayout>
