<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_metric_tile"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wifiFactorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/source_sans3_semibold"
            android:text="Factor"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/wifiFactorCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_status_check"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/wifiFactorBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/source_sans3_regular"
        android:lineSpacingExtra="3dp"
        android:text="—"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />
</LinearLayout>
