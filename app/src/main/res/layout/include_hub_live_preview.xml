<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_field_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/hubPreviewLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/source_sans3_semibold"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="@color/text_dim"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/hubPreviewHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/source_sans3_semibold"
        android:text="—"
        android:textColor="@color/accent_teal"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/hubPreviewMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/source_sans3_semibold"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hubPreviewDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/source_sans3_regular"
        android:lineSpacingExtra="3dp"
        android:text="—"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <com.towerscope.ar.ui.LosProfileChartView
        android:id="@+id/hubPreviewChart"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="10dp"
        android:background="@color/bg_mid"
        android:contentDescription="@string/install_dashboard_los_chart_content_desc"
        android:visibility="gone" />
</LinearLayout>
