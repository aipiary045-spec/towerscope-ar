<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/item_gap"
    android:background="@drawable/bg_metric_tile"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/subnetRowIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="192.168.1.1"
        android:textColor="@color/accent_teal"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subnetRowUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="http://192.168.1.1/"
        android:textColor="@color/accent_yellow"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/subnetRowMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/source_sans3_regular"
        android:maxLines="4"
        android:text="MAC — · host"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />
</LinearLayout>
