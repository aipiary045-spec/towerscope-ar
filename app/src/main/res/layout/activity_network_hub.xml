<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/networkHubRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="@string/home_hub_network"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/source_sans3_regular"
                android:text="@string/home_hub_network_sub"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/networkHubResumeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_metric_tile"
                android:fontFamily="@font/source_sans3_regular"
                android:padding="12dp"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                android:visibility="gone" />

            <include
                layout="@layout/include_wifi_topology"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="@string/hub_section_connection"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_wfm_group_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/hubConnectionRow"
                    layout="@layout/item_hub_tool_row_inline" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="@string/hub_section_wifi_survey"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_wfm_group_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/hubWifiRow"
                    layout="@layout/item_hub_tool_row_inline" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="66dp"
                    android:background="@color/divider_subtle" />

                <include
                    android:id="@+id/hubWalkRow"
                    layout="@layout/item_hub_tool_row_inline" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="@string/hub_section_local"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_wfm_group_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/hubLanRow"
                    layout="@layout/item_hub_tool_row_inline" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="@string/hub_section_internet"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_wfm_group_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/hubSpeedRow"
                    layout="@layout/item_hub_tool_row_inline" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="66dp"
                    android:background="@color/divider_subtle" />

                <include
                    android:id="@+id/hubPingRow"
                    layout="@layout/item_hub_tool_row_inline" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="66dp"
                    android:background="@color/divider_subtle" />

                <include
                    android:id="@+id/hubDiagnoseRow"
                    layout="@layout/item_hub_tool_row_inline" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="66dp"
                    android:background="@color/divider_subtle" />

                <include
                    android:id="@+id/hubTraceRow"
                    layout="@layout/item_hub_tool_row_inline" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
