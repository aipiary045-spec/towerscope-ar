<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/networkHubRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/source_sans3_semibold"
                android:letterSpacing="0.12"
                android:text="NETWORK"
                android:textColor="@color/accent_teal"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="@string/home_hub_network"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/screen_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/source_sans3_regular"
                android:text="@string/home_hub_network_sub"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/networkHubResumeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_metric_tile"
                android:fontFamily="@font/source_sans3_regular"
                android:padding="10dp"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:letterSpacing="0.1"
                android:text="@string/hub_section_connection"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <include
                android:id="@+id/hubConnectionRow"
                layout="@layout/item_hub_tool_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:letterSpacing="0.1"
                android:text="@string/hub_section_wifi_survey"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/hubWifiRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/hubWalkRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:letterSpacing="0.1"
                android:text="@string/hub_section_local"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <include
                android:id="@+id/hubLanRow"
                layout="@layout/item_hub_tool_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:letterSpacing="0.1"
                android:text="@string/hub_section_internet"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <include
                android:id="@+id/hubSpeedRow"
                layout="@layout/item_hub_tool_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/hubPingRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/hubDiagnoseRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <include
                android:id="@+id/hubTraceRow"
                layout="@layout/item_hub_tool_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
