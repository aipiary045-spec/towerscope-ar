<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/networkHubRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy">

    <com.towerscope.ar.ui.FaceplateView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingTop="14dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/stamp_semibold"
                    android:letterSpacing="0.22"
                    android:text="BAY RF"
                    android:textColor="@color/accent_yellow"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/stamp_semibold"
                    android:letterSpacing="0.08"
                    android:text="@string/home_hub_network"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/stamp_regular"
                    android:text="On-device field checks"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <include
                    android:id="@+id/hubWifiRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <include
                    android:id="@+id/hubChannelRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/hubSpeedRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/hubPingRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/hubSubnetRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/hubDnsRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/hubTraceRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/hubBandwidthRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/hubDiagnoseRow"
                    layout="@layout/item_hub_tool_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/networkBottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/include_bottom_nav" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
