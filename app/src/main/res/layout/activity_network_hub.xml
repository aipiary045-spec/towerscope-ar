<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/networkHubRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/source_sans3_semibold"
        android:text="@string/home_hub_network"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/source_sans3_regular"
        android:text="@string/home_hub_network_sub"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/networkHubResumeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_field_card"
        android:fontFamily="@font/source_sans3_regular"
        android:padding="12dp"
        android:textColor="@color/accent_teal"
        android:textSize="12sp"
        android:visibility="gone" />

    <include
        layout="@layout/include_wifi_topology"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/networkHubTabStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/hubTabConnection"
                layout="@layout/item_wfm_tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/hubTabWifi"
                layout="@layout/item_wfm_tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp" />

            <include
                android:id="@+id/hubTabLocal"
                layout="@layout/item_wfm_tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp" />

            <include
                android:id="@+id/hubTabInternet"
                layout="@layout/item_wfm_tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/hubPanelConnection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/hubConnectionPreview"
                    layout="@layout/include_hub_live_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_wfm_group_card"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/hubConnectionRow"
                        layout="@layout/item_hub_tool_row_inline" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hubPanelWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/hubWifiPreview"
                    layout="@layout/include_hub_live_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_wfm_group_card"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/hubWifiRow"
                        layout="@layout/item_hub_tool_row_inline" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="66dp"
                        android:background="@color/divider_subtle" />

                    <include
                        android:id="@+id/hubWalkRow"
                        layout="@layout/item_hub_tool_row_inline" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hubPanelLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/hubLocalPreview"
                    layout="@layout/include_hub_live_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_wfm_group_card"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/hubLanRow"
                        layout="@layout/item_hub_tool_row_inline" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hubPanelInternet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/hubInternetPreview"
                    layout="@layout/include_hub_live_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/hubInternetPingMetric"
                            layout="@layout/include_home_metric_tile" />

                        <include
                            android:id="@+id/hubInternetSpeedMetric"
                            layout="@layout/include_home_metric_tile"
                            android:layout_marginEnd="0dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hubInternetQuickCheck"
                    style="@style/Widget.TowerScope.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/hub_internet_quick_check" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_wfm_group_card"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/hubSpeedRow"
                        layout="@layout/item_hub_tool_row_inline" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="66dp"
                        android:background="@color/divider_subtle" />

                    <include
                        android:id="@+id/hubPingRow"
                        layout="@layout/item_hub_tool_row_inline" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="66dp"
                        android:background="@color/divider_subtle" />

                    <include
                        android:id="@+id/hubDiagnoseRow"
                        layout="@layout/item_hub_tool_row_inline" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="66dp"
                        android:background="@color/divider_subtle" />

                    <include
                        android:id="@+id/hubTraceRow"
                        layout="@layout/item_hub_tool_row_inline" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
