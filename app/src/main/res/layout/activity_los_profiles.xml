<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/losRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="18dp">

    <include layout="@layout/include_tool_scaffold_header" />

    <TextView
        android:id="@+id/losRangeSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/source_sans3_regular"
        android:text="Rank APs by estimated signal"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <include
        android:id="@+id/losLocationChip"
        layout="@layout/include_location_source_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:id="@+id/losLinkSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_metric_card"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/losLinkSettingsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:letterSpacing="0.06"
                    android:text="LINK SETTINGS"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/losLinkSettingsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/source_sans3_regular"
                    android:maxLines="2"
                    android:text="5.8 GHz · CPE 4 m · Tx 20 · AP 20 · CPE 20 dBi"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/losLinkSettingsToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/source_sans3_semibold"
                android:paddingStart="10dp"
                android:text="Edit"
                android:textColor="@color/accent_yellow"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/losLinkSettingsExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/losFrequencyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="FREQ  5.8 GHz"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/losFrequencySlider"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:max="6"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:progress="3" />

            <TextView
                android:id="@+id/losCpeHeightLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="CPE height  4 m"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/losCpeHeightSlider"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:max="29"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:progress="3" />

            <TextView
                android:id="@+id/losTxPowerLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="TX POWER  20 dBm"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/losTxPowerSlider"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:max="30"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:progress="20" />

            <TextView
                android:id="@+id/losApGainLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="AP GAIN  20 dBi"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/losApGainSlider"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:max="40"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:progress="20" />

            <TextView
                android:id="@+id/losCpeGainLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="CPE GAIN  20 dBi"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/losCpeGainSlider"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:max="40"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:progress="20" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/losRangeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/source_sans3_regular"
        android:textColor="@color/accent_teal"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/losRangeList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/losFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/losRangeCancelButton"
                style="@style/Widget.TowerScope.Button.Ghost"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/los_cancel_ranking"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/losRangeRefreshButton"
                style="@style/Widget.TowerScope.Button.Ghost"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Refresh" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/losRangeHomeButton"
            style="@style/Widget.TowerScope.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Home" />
    </LinearLayout>
</LinearLayout>
