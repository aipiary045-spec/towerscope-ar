<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/item_gap"
    android:background="@drawable/bg_metric_tile"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/siteRowName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/source_sans3_semibold"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/siteRowRangeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_clear"
            android:fontFamily="@font/source_sans3_semibold"
            android:letterSpacing="0.06"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/site_browser_in_range"
            android:textColor="@color/status_clear"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/siteRowMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/accent_teal"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/siteRowDetailsButton"
            style="@style/Widget.TowerScope.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/site_browser_details"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/siteRowAimButton"
            style="@style/Widget.TowerScope.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/site_browser_aim"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/siteRowMapButton"
            style="@style/Widget.TowerScope.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/site_browser_map"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/siteRowLosButton"
            style="@style/Widget.TowerScope.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/site_browser_los"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
