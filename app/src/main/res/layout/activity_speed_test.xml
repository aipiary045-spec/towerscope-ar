<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/speedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/source_sans3_semibold"
        android:letterSpacing="0.01"
        android:text="@string/home_job_speed"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/screen_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/source_sans3_regular"
        android:text="@string/home_job_speed_sub"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_metric_tile"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/source_sans3_semibold"
                android:letterSpacing="0.1"
                android:text="DOWN"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/speedDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="-0.02"
                android:text="—"
                android:textColor="@color/accent_teal"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_metric_tile"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/source_sans3_semibold"
                android:letterSpacing="0.1"
                android:text="UP"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/speedUpload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="-0.02"
                android:text="—"
                android:textColor="@color/accent_yellow"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap"
        android:background="@drawable/bg_metric_card"
        android:orientation="vertical"
        android:padding="@dimen/card_padding_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/source_sans3_semibold"
            android:letterSpacing="0.12"
            android:text="LATENCY"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/speedLatency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="-0.02"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="36sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/speedStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/source_sans3_regular"
        android:text="Uses Cloudflare speed endpoints"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/speedRunButton"
        style="@style/Widget.TowerScope.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Run speed test" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/speedBackButton"
        style="@style/Widget.TowerScope.Button.Ghost"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/item_gap"
        android:layout_marginBottom="14dp"
        android:text="Back" />
</LinearLayout>
