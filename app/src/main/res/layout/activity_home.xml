<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeSwipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_topo_screen">

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/homeRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_well">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:src="@mipmap/ic_launcher" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/source_sans3_semibold"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/source_sans3_regular"
                        android:text="@string/home_tagline"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/homeLocationChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_metric_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/source_sans3_semibold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/location_chip_gps_waiting"
                    android:textColor="@color/accent_teal"
                    android:textSize="11sp" />
            </LinearLayout>

            <include
                android:id="@+id/homeNetworkTopology"
                layout="@layout/include_wifi_topology"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/homeMetricWifi"
                        layout="@layout/include_home_metric_tile" />

                    <include
                        android:id="@+id/homeMetricInternet"
                        layout="@layout/include_home_metric_tile" />

                    <include
                        android:id="@+id/homeMetricSpeed"
                        layout="@layout/include_home_metric_tile"
                        android:layout_marginEnd="0dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/source_sans3_semibold"
                        android:letterSpacing="0.08"
                        android:text="@string/home_section_sites"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/homeSitesCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/source_sans3_semibold"
                        android:text="@string/home_no_sites"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/homeInRangeCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/source_sans3_regular"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/source_sans3_semibold"
                        android:letterSpacing="0.08"
                        android:text="@string/home_section_nearest"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/homeNearestLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/source_sans3_semibold"
                        android:maxLines="2"
                        android:text="@string/home_nearest_none"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/homeNearestDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/source_sans3_regular"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/homeGpsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/source_sans3_regular"
                android:text="@string/home_gps_waiting"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeCompassButton"
                style="@style/Widget.TowerScope.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="@string/home_job_aim"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeImportButton"
                style="@style/Widget.TowerScope.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="@string/home_import_sites"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeConnectionButton"
                style="@style/Widget.TowerScope.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/home_job_connection" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="@string/home_section_quick"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_wfm_group_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/homeQuickCompass"
                    layout="@layout/item_home_quick_action_inline" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="66dp"
                    android:background="@color/divider_subtle" />

                <include
                    android:id="@+id/homeQuickLocate"
                    layout="@layout/item_home_quick_action_inline" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="66dp"
                    android:background="@color/divider_subtle" />

                <include
                    android:id="@+id/homeQuickLos"
                    layout="@layout/item_home_quick_action_inline" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="66dp"
                    android:background="@color/divider_subtle" />

                <include
                    android:id="@+id/homeQuickWifi"
                    layout="@layout/item_home_quick_action_inline" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="66dp"
                    android:background="@color/divider_subtle" />

                <include
                    android:id="@+id/homeQuickSpeed"
                    layout="@layout/item_home_quick_action_inline" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="66dp"
                    android:background="@color/divider_subtle" />

                <include
                    android:id="@+id/homeQuickDiagnose"
                    layout="@layout/item_home_quick_action_inline" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/source_sans3_semibold"
                android:text="@string/home_section_browse"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_wfm_group_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/homeNetworkHubButton"
                    layout="@layout/include_home_hub_link_inline" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="66dp"
                    android:background="@color/divider_subtle" />

                <include
                    android:id="@+id/homeInstallHubButton"
                    layout="@layout/include_home_hub_link_inline" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
