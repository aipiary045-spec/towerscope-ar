<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_field_card"
    android:minWidth="108dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/homeMetricLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/source_sans3_semibold"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="@color/text_dim"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/homeMetricHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/source_sans3_semibold"
        android:text="—"
        android:textColor="@color/accent_teal"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/homeMetricMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/source_sans3_regular"
        android:maxLines="2"
        android:text="—"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />
</LinearLayout>
