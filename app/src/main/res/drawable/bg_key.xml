<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated" />
            <corners android:radius="@dimen/radius_sm" />
            <stroke
                android:width="1.5dp"
                android:color="@color/accent_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_mid" />
            <corners android:radius="@dimen/radius_sm" />
            <stroke
                android:width="1dp"
                android:color="@color/border_luminous" />
        </shape>
    </item>
</selector>
