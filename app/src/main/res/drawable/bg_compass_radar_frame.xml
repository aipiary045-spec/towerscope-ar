<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/aurora_violet"
                android:startColor="@color/aurora_rose"
                android:type="linear" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_deep" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
