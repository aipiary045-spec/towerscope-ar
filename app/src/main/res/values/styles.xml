<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TowerScopeAR" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/bg_navy</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="colorPrimary">@color/accent_yellow</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorSurface">@color/surface_slate</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <!-- Do not set theme-wide custom fontFamily — can crash Material inflate on some devices. -->
        <item name="materialButtonStyle">@style/Widget.TowerScope.Button</item>
    </style>

    <style name="TextAppearance.TowerScope.Display" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/source_sans3_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">@dimen/screen_title</item>
    </style>

    <style name="TextAppearance.TowerScope.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/source_sans3_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.TowerScope.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/source_sans3_regular</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.TowerScope.Subtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/source_sans3_regular</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.TowerScope.Meta" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/source_sans3_semibold</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.TowerScope.Data" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/accent_teal</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TowerScope.Metric" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/accent_teal</item>
        <item name="android:textSize">@dimen/metric_value</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.TowerScope.Heading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/source_sans3_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent_teal</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Widget.TowerScope" parent="" />

    <style name="Widget.TowerScope.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">@dimen/tap_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/source_sans3_semibold</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.TowerScope.Button.Primary" parent="Widget.TowerScope.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.TowerScope.Button.Secondary" parent="Widget.TowerScope.Button">
        <item name="backgroundTint">@color/accent_teal</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.TowerScope.Button.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/tap_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/source_sans3_semibold</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.TowerScope.Card">
        <item name="android:background">@drawable/bg_field_card</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:minHeight">@dimen/tap_min</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.TowerScope.MetricTile">
        <item name="android:background">@drawable/bg_metric_tile</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>
