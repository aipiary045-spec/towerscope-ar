<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TowerScopeAR" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/bg_navy</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="colorPrimary">@color/accent_yellow</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnPrimary">@color/bg_deep</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/Widget.TowerScope.Button</item>
    </style>

    <style name="TextAppearance.TowerScope.Display" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent_yellow</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TextAppearance.TowerScope.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.TowerScope.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.TowerScope.Meta" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TextAppearance.TowerScope.Data" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/accent_teal</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.TowerScope.Heading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent_teal</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Widget.TowerScope" parent="" />

    <style name="Widget.TowerScope.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">@dimen/tap_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.TowerScope.Button.Primary" parent="Widget.TowerScope.Button">
        <item name="backgroundTint">@color/accent_yellow</item>
        <item name="android:textColor">@color/bg_deep</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.TowerScope.Button.Secondary" parent="Widget.TowerScope.Button">
        <item name="backgroundTint">@color/accent_teal</item>
        <item name="android:textColor">@color/bg_deep</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.TowerScope.Button.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/tap_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">@color/border_luminous</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.TowerScope.Card">
        <item name="android:background">@drawable/bg_field_card</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:minHeight">@dimen/tap_min</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
