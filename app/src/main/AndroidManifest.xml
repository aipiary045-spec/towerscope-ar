            android:theme="@style/Theme.TowerScopeAR" />

        <activity
            android:name=".SpeedTestActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TowerScopeAR" />

        <activity
            android:name=".PingMonitorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TowerScopeAR" />

        <activity
            android:name=".SubnetScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TowerScopeAR" />

        <activity
            android:name=".NetworkDiagnoseActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TowerScopeAR" />

        <activity
            android:name=".DnsLookupActivity"
